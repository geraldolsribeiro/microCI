ifeq ($(OS),linux)
# https://github.com/sameer49/selenium-cucumber-ruby/blob/master/doc/installation.md
# https://github.com/andrewslotin/selenium-phantomjs/blob/master/README.md

# não dá pra chamar apt dentro de apt
#	echo "apt upgrade -y --allow-unauthenticated" >> $@
#	echo "apt dist-upgrade -y --allow-unauthenticated" >> $@
#	echo "apt install --reinstall -y nodejs" >> $@
# echo "curl -sL https://deb.nodesource.com/setup_11.x | bash -" >> $@
../package/postinst:
	echo "#!/bin/bash" > $@
	echo "### ----------------------------------------------------------------------" >> $@
	echo "### Copyright (C) 2017-2025 Geraldo Ribeiro <geraldo@intmain.io>" >> $@
	echo "### ----------------------------------------------------------------------" >> $@
	echo "npm install -g npm@latest" >> $@
	echo "npm install -g $(NPM_PACKAGE_DEPENDS)" >> $@
	echo "gem update --system" >> $@
	echo "gem install $(GEM_PACKAGE_DEPENDS) --no-document" >> $@
	chmod 755 $@
endif

ifeq ($(OS),macos)
# HIGH_SIERRA_FIX: Tive vários problemas quando atualizei para o high sierra
# HIGH_SIERRA_FIX: https://www.dyclassroom.com/howto-mac/how-to-install-nodejs-and-npm-on-mac-using-homebrew
# HIGH_SIERRA_FIX: https://stackoverflow.com/questions/33870520/npm-install-cannot-find-module-semver
# HIGH_SIERRA_FIX: https://stackoverflow.com/questions/17038402/sass-compass-watch-error-cannot-load-compass
# HIGH_SIERRA_FIX: gem uninstall sass
# HIGH_SIERRA_FIX: e remover a 3.5.5 e deixar a 3.4.25
../package/postinst:
	echo "#!/bin/bash" > $@
	echo "### ----------------------------------------------------------------------" >> $@
	echo "### Copyright (C) 2017-2025 Geraldo Ribeiro <geraldo@intmain.io>" >> $@
	echo "### ----------------------------------------------------------------------" >> $@
	echo "/usr/local/bin/brew install $(BREW_PACKAGE_DEPENDS)" >> $@
	echo "/usr/local/bin/brew install node" >> $@
	echo "/usr/local/bin/brew link --overwrite node" >> $@
	echo "/usr/local/bin/npm update -g" >> $@
	echo "/usr/local/bin/npm install -g $(NPM_PACKAGE_DEPENDS)" >> $@
	echo "/usr/bin/gem update --system" >> $@
	echo "/usr/bin/gem install $(GEM_PACKAGE_DEPENDS) --no-document" >> $@
	echo "exit 0" >> $@
	chmod 755 $@

# HIGH_SIERRA_FIX: 
macos_fix_node:
	sudo chown -R geraldo:admin /usr/local/share/systemtap/
	sudo chown -R geraldo:admin /usr/local/lib/dtrace/
	brew prune
	sudo rm -rf /usr/local/lib/node_modules
	sudo rm -rf ~/.npm
	brew uninstall --force node
	brew install node
	brew link --overwrite node

# HIGH_SIERRA_FIX: https://medium.com/@timmykko/using-openssl-library-with-macos-sierra-7807cfd47892
macos_fix_openssl:
	ln -s /usr/local/opt/openssl/include/openssl /usr/local/include

macos_brew:
	brew install $(BREW_PACKAGE_DEPENDS)

macos_npm:
	npm update -g
	npm install -g $(NPM_PACKAGE_DEPENDS)

macos_gem:
	gem update --system
	gem install $(GEM_PACKAGE_DEPENDS) --no-document

endif

all: ../package/postinst

